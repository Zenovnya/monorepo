# LexBear mobile — пример конфигурации Expo.
# Скопируйте в mobile/.env:
#   cp mobile/.env.example mobile/.env
#
# Переменные с префиксом EXPO_PUBLIC_ попадают в бандл (не храните там секреты).

# Базовый URL API.
#  - Android-эмулятор:  http://10.0.2.2:8000
#  - iOS-симулятор:     http://localhost:8000
#  - Физическое устройство (Expo Go в той же LAN): http://<IP-машины>:8000
#  - Прод:              https://api.example.com
# Если не задано, клиент берёт хост Metro-сервера на порту 8000 (src/api/client.js).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Опционально: включает подробные логи API-клиента в dev.
EXPO_PUBLIC_API_DEBUG=false
