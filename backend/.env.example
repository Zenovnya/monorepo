# LexBear backend — пример конфигурации.
# Скопируйте в backend/.env и подставьте свои значения:
#   cp backend/.env.example backend/.env
# Валидация (app/config.py): вне DEBUG поле JWT_SECRET_KEY обязано быть >= 32 символов.

# --- Приложение ---
# DEBUG=true разрешает /docs и ослабляет проверку JWT_SECRET_KEY (только локально).
DEBUG=true
APP_NAME=LexBear API

# --- База данных ---
# Локально с docker compose (infra/docker) — пользователь lexbear:
# DATABASE_URL=postgresql+asyncpg://lexbear:changeme@localhost:5432/lexbear
# Локально со «своим» Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sourcecraft
# Supabase/Railway: строка с ?ssl=require в конце (см. infra/supabase/DEPLOY.md).
DATABASE_URL=postgresql+asyncpg://lexbear:changeme@localhost:5432/lexbear

# --- Безопасность / JWT ---
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Админ-доступ ---
# Токен для POST /admin/* и /lexbear/seed (заголовок X-Admin-Token).
ADMIN_TOKEN=local-admin-token

# --- CORS ---
# JSON-массив origin'ов; для Expo web и dev-клиента достаточно этих значений.
CORS_ORIGINS=["http://localhost:19006","http://localhost:8081"]
# Необязательная регулярка для LAN-адресов Expo (в production пустая):
# CORS_ORIGIN_REGEX=^http://192\.168\.\d+\.\d+:(19006|8081)$

# --- Прокси ---
# true только за доверенным реверс-прокси (nginx), иначе IP для rate-limit подделывается.
TRUST_PROXY_HEADERS=false

# --- Платежи ---
# "" — провайдер-заглушка (manual). Для MVP оставьте пустым.
PAYMENT_PROVIDER=
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_RETURN_URL=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# --- Аналитика / мониторинг ---
AMPLITUDE_API_KEY=
SENTRY_DSN=
