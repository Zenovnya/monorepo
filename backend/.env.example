# LexBear backend — пример конфигурации.
# Скопируйте в backend/.env и подставьте свои значения:
#   cp backend/.env.example backend/.env
# Валидация (app/config.py): вне DEBUG поле JWT_SECRET_KEY обязано быть >= 32 символов.

# --- Приложение ---
# DEBUG=true разрешает /docs и ослабляет проверку JWT_SECRET_KEY (только локально).
DEBUG=true
APP_NAME=LexBear API

# --- База данных ---
# ЕДИНСТВЕННЫЙ источник истины по строке подключения. Раньше в проекте было
# три разных значения (здесь, в infra/docker/.env.example и в
# scripts/dev-db.ps1), поэтому «локально работает, у соседа нет».
#
# Варианты:
#   1) Windows, локальный кластер через scripts/dev-db.ps1 (порт 5433):
#      postgresql+asyncpg://lexbear:lexbear_dev_pass@localhost:5433/lexbear
#      (скрипт прописывает эту строку сам — вручную задавать не нужно)
#   2) docker compose (infra/docker, пароль берётся из POSTGRES_PASSWORD):
#      postgresql+asyncpg://lexbear:<POSTGRES_PASSWORD>@localhost:5432/lexbear
#   3) свой Postgres:
#      postgresql+asyncpg://postgres:postgres@localhost:5432/sourcecraft
#   4) Supabase/Railway: добавьте ?ssl=require (см. infra/supabase/DEPLOY.md).
#
# Значение ниже — дефолт совпадает с app/config.py, но пароль обязательно
# замените на свой.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sourcecraft

# --- Безопасность / JWT ---
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Админ-доступ ---
# Токен для POST /admin/* и /lexbear/seed (заголовок X-Admin-Token).
ADMIN_TOKEN=local-admin-token

# --- CORS ---
# JSON-массив origin'ов; для Expo web и dev-клиента достаточно этих значений.
CORS_ORIGINS=["http://localhost:19006","http://localhost:8081"]
# Необязательная регулярка для LAN-адресов Expo (в production пустая):
# CORS_ORIGIN_REGEX=^http://192\.168\.\d+\.\d+:(19006|8081)$

# --- Прокси ---
# true только за доверенным реверс-прокси (nginx), иначе IP для rate-limit подделывается.
TRUST_PROXY_HEADERS=false

# --- Платежи ---
# "" — провайдер-заглушка (manual). Для MVP оставьте пустым.
PAYMENT_PROVIDER=
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_RETURN_URL=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# --- Почта (Resend) ---
# Сброс пароля и другие письма. Ключ: https://resend.com/api-keys
# Без ключа приложение работает, но письма не отправляются, а
# /auth/forgot-password честно не раскрывает, существует ли аккаунт.
RESEND_API_KEY=
# Отправитель. Домен должен быть подтверждён в Resend; для тестов можно
# использовать onboarding@resend.dev (письма уходят только на свой адрес).
EMAIL_FROM=LexBear <onboarding@resend.dev>
# Базовый адрес приложения — из него собирается ссылка в письме.
# Локально (Expo web): http://localhost:19006
# Прод: https://ваш-домен
APP_BASE_URL=http://localhost:19006
# Сколько живёт ссылка сброса пароля.
PASSWORD_RESET_TTL_MINUTES=30

# --- Аналитика / мониторинг ---
AMPLITUDE_API_KEY=
SENTRY_DSN=
