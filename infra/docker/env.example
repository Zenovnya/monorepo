# Переменные для infra/docker/docker-compose.yml.
#   cp infra/docker/.env.example infra/docker/.env
POSTGRES_PASSWORD=changeme
# >= 32 символов, иначе backend не стартует (app/config.py).
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ADMIN_TOKEN=local-admin-token
