# Переменные для infra/docker/docker-compose.yml.
#   cp infra/docker/.env.example infra/docker/.env
POSTGRES_PASSWORD=changeme
# >= 32 символов, иначе backend не стартует (app/config.py).
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ADMIN_TOKEN=local-admin-token

# Порт, который docker compose публикует наружу (по умолчанию 5432).
# Если локально уже занят Postgres на 5432 — поставьте 5433 и используйте
# postgresql+asyncpg://lexbear:<POSTGRES_PASSWORD>@localhost:5433/lexbear
POSTGRES_PORT=5432

# Почта (Resend) — нужна для сброса пароля.
# Ключ: https://resend.com/api-keys. Без него письма не отправляются.
RESEND_API_KEY=
EMAIL_FROM=LexBear <onboarding@resend.dev>
# Публичный адрес приложения для ссылок в письмах.
APP_BASE_URL=http://localhost:19006
