# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env

# Пароль для PostgreSQL (придумайте любой надёжный).
POSTGRES_PASSWORD=change-me-strong-password

# Секрет для JWT — МИНИМУМ 32 символа. Сгенерируйте:
#   openssl rand -hex 32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-value-at-least-32-chars

# Токен для служебных эндпоинтов (сид контента, админка). Придумайте любой.
#   openssl rand -hex 16
ADMIN_TOKEN=replace-with-your-admin-token
